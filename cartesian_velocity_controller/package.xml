<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cartesian_velocity_controller</name>
  <version>0.0.0</version>
  <description>The cartesian_velocity_controller package</description>
  <maintainer email="amangana@purdue.edu">Anastasios Manganaris</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/Tass0sm/cartesian_controllers</url>
  <author email="amangana@purdue.edu">Anastasios Manganaris</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>cartesian_controller_base</depend>
  <depend>controller_interface</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/cartesian_velocity_controller_plugin.xml"/>
  </export>
</package>
